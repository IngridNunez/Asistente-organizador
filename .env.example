# Copiar este archivo como .env y completar con valores reales.
# .env nunca se sube a git (ver .gitignore).

# LLM (Groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# STT (si se usa Whisper vía Groq)
# Puede reutilizar GROQ_API_KEY y GROQ_BASE_URL de arriba.

# Google Calendar (etapa 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API del agente (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_AUTH_TOKEN=
