# Copiar este archivo como .env y completar con valores reales.
# .env nunca se sube a git (ver .gitignore).

# LLM (Groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# STT: Whisper vía Groq (decidido). Reutiliza GROQ_API_KEY y GROQ_BASE_URL.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Google Calendar (etapa 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: dónde se guarda el token de cada persona (fuera del repo). Por defecto ~/.sara/token.json
GOOGLE_TOKEN_PATH=

# API del agente (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
# Obligatorio: sin token la API responde 503. Generar uno largo, ej: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
# Obligatorio: usuario fijo de esta instalación. Sin él la API responde 503.
API_USUARIO=
# Solo desarrollo local: true desactiva la autenticación. Nunca en un servidor expuesto.
API_AUTH_DISABLED=
